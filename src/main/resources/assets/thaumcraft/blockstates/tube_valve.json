{
  "multipart": [
    {
      "apply": {
        "model": "thaumcraft:block/tube_core"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_side"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_side",
        "x": 180
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_side",
        "x": 270
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_side",
        "x": 90
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_side",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "thaumcraft:block/tube_side",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "facing": "down"
      },
      "apply": {
        "model": "thaumcraft:block/tube_core_valve"
      }
    },
    {
      "when": {
        "facing": "up"
      },
      "apply": {
        "model": "thaumcraft:block/tube_core_valve",
        "x": 180
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "thaumcraft:block/tube_core_valve",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "thaumcraft:block/tube_core_valve",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "thaumcraft:block/tube_core_valve",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "thaumcraft:block/tube_core_valve",
        "x": 90,
        "y": 270
      }
    }
  ]
}
